# Database
DATABASE_URL="postgresql://user:password@localhost:5432/row_tracking"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"

# OAuth Providers
# Google OAuth - Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth (Optional) - Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Stripe
STRIPE_SECRET_KEY="sk_live_or_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Primary sold plan — ROWFlow Pro $99/mo (includes suite / Tractsource seat messaging)
STRIPE_PRO_PRICE_ID="price_..."
# Optional legacy
STRIPE_BASIC_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# Email (Resend) — counter-offer notifications
RESEND_API_KEY="re_..."
# Prefer ROWFLOW_EMAIL_FROM; EMAIL_FROM also accepted
ROWFLOW_EMAIL_FROM="ROWFlow <noreply@yourdomain.com>"
EMAIL_FROM="noreply@yourdomain.com"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ROWFlow"

# Sentry Error Monitoring (Optional)
# Get from: https://sentry.io/
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# Logging
LOG_LEVEL="info"  # Options: debug, info, warn, error
ENABLE_TEST_LOGS="false"  # Set to true to enable logs in test environment

