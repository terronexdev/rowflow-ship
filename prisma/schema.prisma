// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Authentication Models
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?   // Hashed with bcrypt (optional for OAuth users)
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  assignedParcels Parcel[] @relation("AssignedParcels")
  subscription  Subscription?
  roleAssignments     RoleAssignment[]
  costEntries         ParcelCostEntry[]
  compensationOffers  CompensationOffer[] @relation("CompensationCreatedBy")
  authoredNotes       Note[] @relation("NoteAuthor")
  uploadedDocuments   Document[] @relation("DocumentUploader")
  contactLogsCreated  ContactLog[] @relation("ContactLogCreatedBy")
  projectMemberships  ProjectMember[]
  invitesSent         ProjectInvite[] @relation("InvitesSent")
  auditLogs           AuditLog[]
  /// Dashboard layout, last seen activity, etc.
  uiPrefs             Json?
  lastSeenActivityAt  DateTime?

  @@map("users")
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// Subscription Models
// ============================================

model Subscription {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  stripeCustomerId         String?            @unique
  stripeSubscriptionId     String?            @unique
  stripePriceId            String?
  stripeCurrentPeriodEnd   DateTime?
  tier                     SubscriptionTier   @default(FREE)
  status                   SubscriptionStatus @default(ACTIVE)
  projectLimit             Int                @default(2)
  parcelLimitPerProject    Int                @default(50)
  userLimit                Int                @default(1)
  storageLimit             Int                @default(0) // in MB
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum Role {
  USER
  AGENT
  PROJECT_MANAGER
  ADMIN
}

enum ParcelPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  BLOCKED
}

enum SubscriptionTier {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

// ============================================
// Core Application Models
// ============================================

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("Active")
  clientName  String?
  contractNumber String?
  workOrderNumber String?
  projectType String?
  /// Business-facing Project ID (not the cuid)
  projectCode String?
  landBudget  Decimal?  @db.Decimal(12,2)
  laborBudget Decimal?  @db.Decimal(12,2)
  centerlineData Json?   // GeoJSON linework for alignment/route
  rowExtents Json?       // GeoJSON corridor/ROW extents
  scopeEstimateJson Json?    // ROWScope seed snapshot (take + budget, not offers)
  startDate   DateTime?
  endDate     DateTime?
  offerRangeLowPct  Decimal @default(0.80) @db.Decimal(5, 4)
  offerRangeHighPct Decimal @default(1.50) @db.Decimal(5, 4)
  /// IRS-style mileage rate snapshot default for new mileage lines ($/mile)
  mileageRate       Decimal @default(0.70) @db.Decimal(6, 4)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parcels Parcel[]
  layers ProjectLayer[]
  milestones Milestone[]
  payments Payment[]
  landPaymentMatrix LandPaymentMatrix?
  roleAssignments   RoleAssignment[]
  roleRates         RoleRate[]
  budgetLines       BudgetLine[]
  schedulePhases    ProjectSchedulePhase[]
  permits           Permit[]
  notes             Note[]
  documents         Document[]
  members           ProjectMember[]
  invites           ProjectInvite[]
  auditLogs         AuditLog[]
  existingRights    ExistingRight[]

  @@index([userId])
  @@index([projectCode])
  @@map("projects")
}

model ProjectLayer {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  datasetId   String?
  sourceUrl   String?
  kind        String   @default("reference")
  geometryType String?
  featureCount Int     @default(0)
  data        Json
  visible     Boolean  @default(true)
  opacity     Float    @default(0.55)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([datasetId])
  @@map("project_layers")
}

model Parcel {
  id           String       @id @default(cuid())
  projectId    String
  parcelNumber String?
  pin          String?
  /// Project tract / easement file # (this job) — not an existing-rights instrument number
  easementNumber String?
  /// This project's utility plant IDs on the take (poles, towers, etc.)
  newStructureNumbers String?
  /// In-place / foreign utility plant IDs (often under existing easements)
  existingStructureNumbers String?
  owner        String?
  ownerAddress String?
  ownerCity    String?
  ownerState   String?
  ownerZip     String?
  ownerPhone   String?
  ownerEmail   String?
  legalDesc              String?
  county                 String?
  propertyAddress        String?
  state                  String?
  status                 ParcelStatus              @default(NOT_STARTED)
  titleStatus            TitleStatus               @default(NOT_STARTED)
  surveyStatus           SurveyStatus              @default(NOT_STARTED)
  appraisalStatus        AppraisalStatus           @default(NOT_STARTED)
  acquisitionStatus      AcquisitionStatus          @default(NOT_STARTED)
  condemnationStatus     CondemnationStatus         @default(NOT_STARTED)
  damagesStatus          DamagesStatus             @default(NOT_STARTED)
  specialConditionsStatus SpecialConditionsStatus  @default(NOT_STARTED)
  /// Research completeness for existing rights on this tract
  existingRightsStatus   ExistingRightsStatus      @default(NOT_REVIEWED)
  /// Corridor role: greenfield / brownfield / 3rd-party access
  parcelClass            ParcelClass               @default(UNKNOWN)
  /// Encroachment research / disposition rollup for this tract
  encroachmentStatus     EncroachmentStatus        @default(NOT_REVIEWED)
  sequence               Int?
  milepost               Float?
  geometry               Json?                      // GeoJSON geometry
  acreage                Float?
  totalAcres             Decimal?                   @db.Decimal(10,3)
  easementAcres          Decimal?                   @db.Decimal(10,3)
  tceAcres               Decimal?                   @db.Decimal(10,3)
  stationStart           String?
  stationEnd             String?
  priority               ParcelPriority             @default(NORMAL)
  assignedAgentId        String?
  dataSource             String                     @default("MANUAL")
  ptsStatus              PtsStatus                  @default(NOT_STARTED)
  /// Parcel-level permitting phase (Color-by / bulk). Child Permit rows hold filings.
  permitStatus           PermitPhaseStatus          @default(NOT_STARTED)
  /// Project-wide attention pin (sort / filters). Not a land fact.
  bookmarked             Boolean                    @default(false)

  // Titled Owner (owner of record — separate from county GIS owner*)
  titledOwnerName        String?
  titledOwnerAddress     String?
  titledOwnerCity        String?
  titledOwnerState       String?
  titledOwnerZip         String?
  titledOwnerPhone       String?
  titledOwnerEmail       String?
  titledOwnerTaxId       String?
  titledOwnerDistrict    String?
  titledLegalDescription String?
  easementAcresToAcquire Decimal?                   @db.Decimal(10,3)

  // Tenant
  tenantName             String?
  tenantAddress          String?
  tenantPhone            String?
  tenantEmail            String?
  tenantNotes            String?

  // Last offer cache for side panel
  lastCompensationTotal        Decimal? @db.Decimal(12,2)
  lastCompensationLandUse      String?
  lastCompensationOutsideRange Boolean  @default(false)

  /// Survey / take classification (source of truth for compensation)
  matrixLandUse                LandUseCategory?
  matrixLandUseLabel           String?

  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  // Relations
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedAgent User?   @relation("AssignedParcels", fields: [assignedAgentId], references: [id])
  notes     Note[]
  documents Document[]
  titleTracking TitleTracking[]
  surveyTracking SurveyTracking[]
  appraisalTracking AppraisalTracking[]
  acquisitionTracking AcquisitionTracking[]
  condemnationTracking CondemnationTracking[]
  damageClaims DamageClaim[]
  payments Payment[]
  contactLogs ContactLog[]
  compensationOffers CompensationOffer[]
  costEntries        ParcelCostEntry[]
  labels             ParcelLabel[]
  permits            Permit[]
  existingRightLinks ExistingRightParcel[]
  encroachments      ParcelEncroachment[]

  @@index([projectId])
  @@index([status])
  @@index([titleStatus])
  @@index([damagesStatus])
  @@index([specialConditionsStatus])
  @@index([existingRightsStatus])
  @@index([parcelClass])
  @@index([encroachmentStatus])
  @@index([ptsStatus])
  @@index([permitStatus])
  @@index([bookmarked])
  @@index([priority])
  @@index([county])
  @@index([assignedAgentId])
  @@map("parcels")
}

/// Fixed constraint / attention labels (map hatch). Multi per parcel; optional note.
model ParcelLabel {
  id        String          @id @default(cuid())
  parcelId  String
  code      ParcelLabelCode
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@unique([parcelId, code])
  @@index([parcelId])
  @@index([code])
  @@map("parcel_labels")
}

model Note {
  id        String         @id @default(cuid())
  /// Exactly one of parcelId | projectId | permitId (enforced in app + optional DB check)
  parcelId  String?
  projectId String?
  permitId  String?
  content   String
  category  StatusCategory @default(GENERAL)
  authorId  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  parcel  Parcel?  @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permit  Permit?  @relation(fields: [permitId], references: [id], onDelete: Cascade)
  author  User?    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([parcelId])
  @@index([projectId])
  @@index([permitId])
  @@index([category])
  @@map("notes")
}

model Document {
  id           String         @id @default(cuid())
  parcelId     String?
  projectId    String?
  permitId     String?
  name         String
  type         String
  category     StatusCategory @default(GENERAL)
  url          String
  size         Int
  mimeType     String
  label        String?
  uploadedById String?
  createdAt    DateTime       @default(now())

  parcel     Parcel?  @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  permit     Permit?  @relation(fields: [permitId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([parcelId])
  @@index([projectId])
  @@index([permitId])
  @@index([category])
  @@map("documents")
}

// ============================================
// ROWFlow Lifecycle Models
// ============================================

model Milestone {
  id            String          @id @default(cuid())
  projectId     String
  name          String
  description   String?
  targetDate    DateTime?
  completedDate DateTime?
  status        MilestoneStatus @default(NOT_STARTED)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([targetDate])
  @@map("milestones")
}

model TitleTracking {
  id               String          @id @default(cuid())
  parcelId         String
  company          String?
  searchType       TitleSearchType @default(FULL)
  orderDate        DateTime?
  receivedDate     DateTime?
  curativeIssues   String?
  curativeComplete DateTime?
  commitmentDate   DateTime?
  policyDate       DateTime?
  cost             Decimal?        @db.Decimal(8,2)
  bpid             String?
  workOrder        String?
  status           TitleStatus     @default(NOT_STARTED)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@index([status])
  @@map("title_tracking")
}

model SurveyTracking {
  id             String       @id @default(cuid())
  parcelId       String
  company        String?
  surveyType     SurveyType   @default(BOUNDARY)
  acres          Decimal?     @db.Decimal(10,3)
  orderDate      DateTime?
  fieldStartDate DateTime?
  fieldEndDate   DateTime?
  stakingDate    DateTime?
  draftDate      DateTime?
  finalDate      DateTime?
  cost           Decimal?     @db.Decimal(8,2)
  bpid           String?
  workOrder      String?
  monumentSet    Boolean      @default(false)
  status         SurveyStatus @default(NOT_STARTED)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@index([status])
  @@map("survey_tracking")
}

model AppraisalTracking {
  id             String          @id @default(cuid())
  parcelId       String
  appraiser      String?
  appraisalType  AppraisalType   @default(FEE_SIMPLE)
  scope          String?
  orderDate      DateTime?
  inspectionDate DateTime?
  draftDate      DateTime?
  reviewDate     DateTime?
  finalDate      DateTime?
  beforeValue    Decimal?        @db.Decimal(12,2)
  afterValue     Decimal?        @db.Decimal(12,2)
  easementValue  Decimal?        @db.Decimal(12,2)
  damageValue    Decimal?        @db.Decimal(12,2)
  totalValue     Decimal?        @db.Decimal(12,2)
  cost           Decimal?        @db.Decimal(8,2)
  bpid           String?
  workOrder      String?
  status         AppraisalStatus @default(NOT_STARTED)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@index([status])
  @@map("appraisal_tracking")
}

model AcquisitionTracking {
  id                 String            @id @default(cuid())
  parcelId           String
  acquisitionType    AcquisitionType   @default(EASEMENT)
  tier1Offer         Decimal?          @db.Decimal(12,2) // 80%
  tier1Date          DateTime?
  tier1Response      OfferResponse?
  tier2Offer         Decimal?          @db.Decimal(12,2) // 100%
  tier2Date          DateTime?
  tier2Response      OfferResponse?
  tier3Offer         Decimal?          @db.Decimal(12,2) // 125%
  tier3Date          DateTime?
  tier3Response      OfferResponse?
  tier4Offer         Decimal?          @db.Decimal(12,2) // 150%
  tier4Date          DateTime?
  tier4Response      OfferResponse?
  aboveTierOffer     Decimal?          @db.Decimal(12,2)
  approvalRequested  DateTime?
  approvedBy         String?
  approvalDate       DateTime?
  counterOfferAmount Decimal?          @db.Decimal(12,2)
  counterOfferDate   DateTime?
  finalAmount        Decimal?          @db.Decimal(12,2)
  agreementDate      DateTime?
  closingDate        DateTime?
  recordingDate      DateTime?
  documentNumber     String?
  agentFee           Decimal?          @db.Decimal(8,2)
  status             AcquisitionStatus @default(NOT_STARTED)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@index([status])
  @@map("acquisition_tracking")
}

model CondemnationTracking {
  id                   String             @id @default(cuid())
  parcelId             String
  caseNumber           String?
  court                String?
  courtDistrict        String?
  courtAddress         String?
  judge                String?
  /// Our / condemnor counsel
  counsel              String?
  counselFirm          String?
  counselPhone         String?
  counselEmail         String?
  /// Landowner opposing counsel
  opposingCounsel      String?
  opposingCounselFirm  String?
  opposingCounselPhone String?
  opposingCounselEmail String?
  opposingCounselAddress String?
  noticeSentDate       DateTime?
  petitionFiledDate    DateTime?
  servedDate           DateTime?
  hearingDate          DateTime?
  awardAmount          Decimal?           @db.Decimal(12,2)
  awardDate            DateTime?
  /// Snapshot of last/final offer before or during ED (Comp remains ledger source)
  finalOfferAmount     Decimal?           @db.Decimal(12,2)
  finalOfferDate       DateTime?
  appealFiled          Boolean            @default(false)
  trialDate            DateTime?
  judgmentDate         DateTime?
  possessionDate       DateTime?
  legalCosts           Decimal?           @db.Decimal(8,2)
  status               CondemnationStatus @default(NOT_STARTED)
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@index([status])
  @@map("condemnation_tracking")
}

model DamageClaim {
  id               String       @id @default(cuid())
  parcelId         String
  damageType       DamageType
  description      String?
  assessedAmount   Decimal?     @db.Decimal(10,2)
  negotiatedAmount Decimal?     @db.Decimal(10,2)
  paidAmount       Decimal?     @db.Decimal(10,2)
  inspector        String?
  inspectionDate   DateTime?
  status           DamageStatus @default(REPORTED)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@index([status])
  @@map("damage_claims")
}

model Payment {
  id            String        @id @default(cuid())
  projectId     String
  parcelId      String?
  payeeName     String
  paymentType   PaymentType   @default(EASEMENT)
  amount        Decimal       @db.Decimal(12,2)
  requestDate   DateTime?
  approvedDate  DateTime?
  paidDate      DateTime?
  checkNumber   String?
  status        PaymentStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parcel  Parcel? @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([parcelId])
  @@index([status])
  @@map("payments")
}

model ContactLog {
  id           String      @id @default(cuid())
  parcelId     String
  contactType  ContactType
  contactDate  DateTime    @default(now())
  subject      String?
  summary      String
  outcome      String?
  followUpDate DateTime?
  /// User who logged the contact (audit)
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  parcel    Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ContactLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([parcelId])
  @@index([contactDate])
  @@index([createdById])
  @@map("contact_logs")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  projectId  String?
  parcelId   String?
  action     AuditAction
  entityType String
  entityId   String
  /// Human label e.g. "PTS: NOT_STARTED → GRANTED"
  summary    String?
  changes    Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId, createdAt])
  @@index([parcelId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

enum ParcelStatus {
  NOT_STARTED
  IN_PROGRESS
  ACQUIRED
  CONDEMNED
  RELOCATED
}

enum TitleStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  CURATIVE
  HOLD
}

enum TitleSearchType {
  FULL
  UPDATE
  CURRENT_OWNER
  O_AND_E
}

enum SurveyStatus {
  NOT_STARTED
  ORDERED
  FIELD_WORK
  DRAFTING
  REVIEW
  COMPLETE
  HOLD
}

enum SurveyType {
  BOUNDARY
  TOPOGRAPHIC
  ALTA
  ROW_STAKING
  AS_BUILT
}

enum AppraisalStatus {
  NOT_STARTED
  ORDERED
  INSPECTION_SCHEDULED
  DRAFT_RECEIVED
  UNDER_REVIEW
  FINAL
  HOLD
}

enum AppraisalType {
  FEE_SIMPLE
  EASEMENT
  DAMAGES_ONLY
  REVIEW
}

enum AcquisitionStatus {
  NOT_STARTED
  OWNER_CONTACTED
  OFFER_PREPARED
  OFFER_PRESENTED
  NEGOTIATING
  AGREEMENT_REACHED
  CLOSING
  ACQUIRED
  CONDEMNATION_RECOMMENDED
  HOLD
}

enum AcquisitionType {
  FEE_SIMPLE
  PERMANENT_EASEMENT
  TEMPORARY_EASEMENT
  ACCESS_EASEMENT
  EASEMENT
}

enum OfferResponse {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  NO_RESPONSE
}

enum CondemnationStatus {
  NOT_STARTED
  NOTICE_SENT
  PETITION_FILED
  SERVED
  HEARING_SCHEDULED
  AWARD_ISSUED
  APPEALED
  TRIAL
  JUDGMENT
  POSSESSION_GRANTED
  COMPLETE
}

enum DamagesStatus {
  NOT_STARTED
  INVESTIGATE
  REPORT
  RESOLVED
}

enum DamageType {
  CROP
  TIMBER
  FENCE
  IRRIGATION
  ACCESS
  CONSTRUCTION
  TCE_RENTAL
  BUSINESS_LOSS
  LANDSCAPING
  WELL_SEPTIC
  ENVIRONMENTAL
  OTHER
}

enum DamageStatus {
  REPORTED
  INVESTIGATING
  ASSESSED
  NEGOTIATING
  APPROVED
  PAID
  DENIED
}

enum PaymentType {
  EASEMENT
  FEE_ACQUISITION
  DAMAGES
  TCE
  RELOCATION
  LEGAL
  VENDOR
  OTHER
}

enum PaymentStatus {
  PENDING
  APPROVED
  ISSUED
  CLEARED
  VOID
  HOLD
}

enum ContactType {
  PHONE
  EMAIL
  LETTER
  IN_PERSON
  TEXT
  MEETING
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  IMPORT
  EXPORT
  LOGIN
}

enum SpecialConditionsStatus {
  NOT_STARTED
  NOTIFICATION_REQUIRED
  LOCKED_GATE
  HERBICIDES
  FORESTRY
  OTHER
}

enum StatusCategory {
  GENERAL
  TITLE
  SURVEY
  APPRAISAL
  ACQUISITION
  CONDEMNATION
  SPECIAL_CONDITIONS
  DAMAGES
  PTS
  COMPENSATION
  LABOR
  PERMIT
  PROJECT
  LEGAL
  EXISTING_RIGHTS
  ENCROACHMENT
}

// ============================================
// Project enhancement enums & models (flat Project)
// ============================================

enum PtsStatus {
  NOT_STARTED
  REQUESTED
  GRANTED
  DENIED
  ON_HOLD
  EXPIRED
  NOT_REQUIRED
}

enum AssignmentRole {
  MANAGER
  LEAD_AGENT
