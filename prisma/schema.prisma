model LandPaymentMatrix {
  id        String   @id @default(cuid())
  projectId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rows    LandPaymentMatrixRow[]

  @@map("land_payment_matrices")
}

model LandPaymentMatrixRow {
  id          String          @id @default(cuid())
  matrixId    String
  landUse     LandUseCategory
  customLabel String?
  unit        MatrixUnit      @default(PER_ACRE)
  minAmount   Decimal         @db.Decimal(12, 2)
  maxAmount   Decimal         @db.Decimal(12, 2)
  notes       String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  matrix LandPaymentMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@index([matrixId])
  @@map("land_payment_matrix_rows")
}

model RoleAssignment {
  id            String         @id @default(cuid())
  projectId     String
  userId        String
  role          AssignmentRole
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?
  isCurrent     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, role, isCurrent])
  @@index([userId])
  @@map("role_assignments")
}

model RoleRate {
  id            String         @id @default(cuid())
  projectId     String
  role          AssignmentRole
  hourlyRate    Decimal        @db.Decimal(10, 2)
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?
  isCurrent     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, role, isCurrent])
  @@map("role_rates")
}

model BudgetLine {
  id        String         @id @default(cuid())
  projectId String
  category  BudgetCategory
  label     String?
  mode      BudgetLineMode @default(TOTAL)
  amount    Decimal?       @db.Decimal(12, 2)
  hours     Decimal?       @db.Decimal(10, 2)
  rate      Decimal?       @db.Decimal(10, 2)
  total     Decimal        @db.Decimal(12, 2)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("budget_lines")
}

model ProjectSchedulePhase {
  id         String           @id @default(cuid())
  projectId  String
  track      ScheduleTrack
  phaseKey   SchedulePhaseKey
  label      String?
  startDate  DateTime?
  endDate    DateTime?
  /// When true, phase is done — not LATE even if endDate is past
  isComplete Boolean          @default(false)
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, phaseKey])
  @@index([projectId, track])
  @@map("project_schedule_phases")
}

model Permit {
  id              String       @id @default(cuid())
  projectId       String
  /// Optional tract link. null = project-wide / corridor permit.
  parcelId        String?
  name            String
  permitType      PermitType   @default(OTHER)
  status          PermitStatus @default(NOT_STARTED)
  agency          String?
  referenceNumber String?
  submittedDate   DateTime?
  approvedDate    DateTime?
  expirationDate  DateTime?
  permitteeName   String?
  permitteeOrg    String?
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  contactAddress  String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parcel    Parcel?    @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  notesList Note[]
  documents Document[]

  @@index([projectId])
  @@index([parcelId])
  @@index([status])
  @@map("permits")
}

model CompensationOffer {
  id                 String               @id @default(cuid())
  parcelId           String
  landUse            LandUseCategory
  landUseLabel       String?
  matrixRowId        String?
  easementAcres      Decimal              @db.Decimal(10, 3)
  matrixMinUnit      Decimal              @db.Decimal(12, 2)
  matrixMaxUnit      Decimal              @db.Decimal(12, 2)
  unit               MatrixUnit           @default(PER_ACRE)
  rangeLow           Decimal              @db.Decimal(12, 2)
  rangeHigh          Decimal              @db.Decimal(12, 2)
  negotiatedAmount   Decimal              @db.Decimal(12, 2)
  damages            Decimal              @default(0) @db.Decimal(12, 2)
  otherAmount        Decimal              @default(0) @db.Decimal(12, 2)
  total              Decimal              @db.Decimal(12, 2)
  outsideRange       Boolean              @default(false)
  outsideRangeReason String?
  decision           CompensationDecision @default(DRAFT)
  counterEmailSentAt DateTime?
  counterEmailTo     String?
  createdById        String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  parcel    Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("CompensationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([parcelId])
  @@index([decision])
  @@map("compensation_offers")
}


/// Unified parcel cost ledger (time, professional fees, expenses, mileage)
enum CostDiscipline {
  ROW
  TITLE
  SURVEY
  APPRAISAL
  LEGAL
  CONSTRUCTION
  PERMITTING
  GENERAL
}

enum CostEntryType {
  TIME
  FEE
  EXPENSE
  MILEAGE
}

enum CostFeeCode {
  APPRAISAL
  EDIT
  UPDATE
  EXHIBIT
  FILING
  OTHER
}

enum CostExpenseCategory {
  MILEAGE
  LODGING
  MEALS
  FILING
  COURIER
  SUPPLIES
  OTHER
}

model ParcelCostEntry {
  id              String              @id @default(cuid())
  parcelId        String
  userId          String
  discipline      CostDiscipline
  entryType       CostEntryType
  workDate        DateTime            @db.Date
  /// TIME
  hours           Decimal?            @db.Decimal(8, 2)
  role            AssignmentRole?
  hourlyRate      Decimal?            @db.Decimal(10, 2)
  /// FEE
  feeCode         CostFeeCode?
  /// EXPENSE
  expenseCategory CostExpenseCategory?
  vendor          String?
  /// MILEAGE
  miles           Decimal?            @db.Decimal(10, 2)
  mileageRate     Decimal?            @db.Decimal(6, 4)
  /// Always stored total $
  amount          Decimal             @db.Decimal(12, 2)
  description     String?
  billable        Boolean             @default(true)
  /// Finance receipt (not work-product Document)
  receiptUrl      String?
  receiptName     String?
  receiptMimeType String?
  receiptSize     Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@index([parcelId, discipline])
  @@index([userId])
  @@index([workDate])
  @@index([entryType])
  @@map("parcel_cost_entries")
}

/// Team access beyond owner (invite accepted)
model ProjectMember {
  id        String         @id @default(cuid())
  projectId String
  userId    String
  role      AssignmentRole @default(AGENT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// Pending team invites (email may not have an account yet)
model ProjectInvite {
  id          String         @id @default(cuid())
  projectId   String
  email       String
  role        AssignmentRole @default(AGENT)
  token       String         @unique
  status      String         @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([email, status])
  @@map("project_invites")
}

// ============================================
// Existing rights (project instruments × parcels)
// ============================================

/// Parcel research / strategy status for existing rights on this tract
enum ExistingRightsStatus {
  NOT_REVIEWED
  NONE
  RESTRICTED
  SUPPLEMENT_NEEDED
  SUPPLEMENT_ACQUIRED
}

/// Why this parcel is on the project corridor
enum ParcelClass {
  UNKNOWN
  GREENFIELD
  BROWNFIELD
  THIRD_PARTY
}

enum ExistingRightType {
  EASEMENT
  ROW
  LICENSE
  COVENANT
  LEASE
  OTHER
}

enum ExistingRightPurpose {
  INGRESS_EGRESS
  UTILITY
  PIPELINE
  RAIL
  ACCESS
  DRAINAGE
  ELECTRIC
  TELECOM
  OTHER
}

enum ExistingRightLife {
  ACTIVE
  RELEASED
  EXPIRED
  UNKNOWN
}

enum ExistingRightImpact {
  FULL
  PARTIAL
  UNKNOWN
}

/// Project-scoped instrument (one easement # shared across split parcels)
model ExistingRight {
  id                     String               @id @default(cuid())
  projectId              String
  /// Display easement / instrument number
  instrumentNumber       String?
  /// Normalized key for same-# matching within project
  instrumentNumberNorm   String?
  name                   String?
  rightType              ExistingRightType    @default(EASEMENT)
  purpose                ExistingRightPurpose @default(OTHER)
  grantor                String?
  grantee                String?
  county                 String?
  recordingBook          String?
  recordingPage          String?
  recordingInstrument    String?
  recordingDate          DateTime?
  widthFeet              Decimal?             @db.Decimal(10, 2)
  widthNotes             String?
  termNotes              String?
  lifeStatus             ExistingRightLife    @default(ACTIVE)
  /// String[] flag codes: INGRESS_EGRESS, HERBICIDE, POLE, MATERIAL, …
  restrictionFlags       Json?
  restrictionsNote       String?
  affectsProject         Boolean?
  /// Optional corridor geometry (GeoJSON)
  geometry               Json?
  geometrySource         String?
  notes                  String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  project Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parcels ExistingRightParcel[]

  @@index([projectId])
  @@index([projectId, instrumentNumberNorm])
  @@index([lifeStatus])
  @@map("existing_rights")
}

model ExistingRightParcel {
  id              String              @id @default(cuid())
  existingRightId String
  parcelId        String
  impact          ExistingRightImpact @default(UNKNOWN)
  note            String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  existingRight ExistingRight @relation(fields: [existingRightId], references: [id], onDelete: Cascade)
  parcel        Parcel        @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@unique([existingRightId, parcelId])
  @@index([parcelId])
  @@index([existingRightId])
  @@map("existing_right_parcels")
}

// ============================================
// Encroachments (parcel items + rollup status)
// ============================================

/// Parcel-level encroachment research / disposition rollup
enum EncroachmentStatus {
  NOT_REVIEWED
  NONE
  IDENTIFIED
  NEEDS_REMOVAL
  CAN_REMAIN
  REMOVED
}

enum EncroachmentType {
  BUILDING
  SHED
  FENCE
  DRIVEWAY
  PARKING
  SEPTIC
  WELL
  CROP_ORCHARD
  LANDSCAPING
  UTILITIES
  STOCKPILE
  OTHER
}

enum EncroachmentDisposition {
  IDENTIFIED
  NEEDS_REMOVAL
  CAN_REMAIN
  REMOVED
}

enum EncroachmentResponsibility {
  OWNER
  COMPANY
  SHARED
  UNKNOWN
}

enum YesNoUnknown {
  YES
  NO
  UNKNOWN
}

model ParcelEncroachment {
  id                 String                     @id @default(cuid())
  parcelId           String
  encroachmentType   EncroachmentType           @default(OTHER)
  description        String?
  locationNote       String?
  disposition        EncroachmentDisposition    @default(IDENTIFIED)
  inPermanentEasement YesNoUnknown              @default(UNKNOWN)
  inTce              YesNoUnknown               @default(UNKNOWN)
  ownerResponsibility EncroachmentResponsibility @default(UNKNOWN)
  agreementRef       String?
  estimatedCost      Decimal?                   @db.Decimal(12, 2)
  actualCost         Decimal?                   @db.Decimal(12, 2)
  costNotes          String?
  identifiedDate     DateTime?
  resolvedDate       DateTime?
  notes              String?
  sortOrder          Int                        @default(0)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@index([disposition])
  @@index([encroachmentType])
  @@map("parcel_encroachments")
}
